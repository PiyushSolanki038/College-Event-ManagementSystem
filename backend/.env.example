# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/cems"

# Server
PORT=5000
FRONTEND_URL="http://localhost:5173"

# REQUIRED — server refuses to start without this. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-value"

# SMTP (mailer.ts)
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
